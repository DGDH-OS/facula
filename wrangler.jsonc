{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facula-app",
  "main": "cf-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "facula-app" }],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "opennext-cache-facula", "jurisdiction": "eu" },
    { "binding": "FACULA_TEMPLATES", "bucket_name": "facula-templates", "jurisdiction": "eu" }
  ],
  "triggers": { "crons": ["0 5 * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
